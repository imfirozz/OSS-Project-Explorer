# Open Source GitHub Project Explorer - Environment Configuration

# (Optional) Optional personal access token for higher GitHub REST API rate limits (5,000 req/hr vs 60 req/hr)
# VITE_GITHUB_TOKEN=your_github_personal_access_token_here

# (Optional) Base API URL override (defaults to https://api.github.com)
# VITE_GITHUB_API_BASE_URL=https://api.github.com
